{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core permissions, external links, updater, and process relaunch.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://app.dopedb.dev/auth/device?user_code=*"
        },
        {
          "url": "https://app.dopedb.dev/settings*"
        },
        {
          "url": "https://dopedb.dev/privacy"
        },
        {
          "url": "https://github.com/apps/dopedb-knowledge/installations/new?state=*"
        },
        {
          "url": "https://docs.anthropic.com/en/docs/claude-code/getting-started"
        },
        {
          "url": "https://help.openai.com/en/articles/11096431"
        },
        {
          "url": "https://github.com/json-choi/dopedb/releases/latest"
        },
        {
          "url": "https://app.dopedb.dev/analyses/*"
        }
      ]
    },
    "updater:default",
    "process:default"
  ]
}
