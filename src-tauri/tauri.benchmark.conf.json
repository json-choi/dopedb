{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DopeDB Benchmark",
  "identifier": "dev.dopedb.desktop.benchmark",
  "build": {
    "beforeBuildCommand": "node scripts/build-packaged-benchmark.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "DopeDB Benchmark",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#00000000",
        "transparent": true,
        "windowEffects": {
          "effects": ["hudWindow", "underWindowBackground", "windowBackground", "acrylic", "mica", "blur"],
          "state": "followsWindowActiveState",
          "radius": 10,
          "color": "#1c212888"
        },
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["dopedb-benchmark"]
      }
    },
    "updater": {
      "endpoints": []
    }
  }
}
