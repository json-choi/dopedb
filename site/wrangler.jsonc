{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopedb-site",
  "main": ".open-next/worker.js",
  "account_id": "0af3820c996f277b2f17ee446d03f60a",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dopedb.dev", "custom_domain": true },
    { "pattern": "www.dopedb.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dopedb-site"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": {
      "invocation_logs": false
    }
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "analytics_engine_datasets": [
    {
      "binding": "SITE_ANALYTICS",
      "dataset": "dopedb_site"
    }
  ],
  "ratelimits": [
    {
      "name": "SITE_ANALYTICS_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
