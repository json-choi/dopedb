{
  "name": "dopedb",
  "private": true,
  "version": "0.4.48",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "prebuild": "node scripts/generate-desktop-login-page.mjs --check",
    "generate:desktop-login": "node scripts/generate-desktop-login-page.mjs",
    "dev": "vite --config vite.config.ts",
    "build": "node scripts/generate-skill-bundle.mjs --check && node scripts/prepare-agent-runtime.mjs --check-config && node scripts/agent-runtime/build-acp-plugin.mjs --check-config && node scripts/issue-review/local-issue-review.mjs --self-test && node scripts/check-workspace-server-logs.mjs && node scripts/release/generate-release-notes.mjs check && node scripts/check-architecture.mjs && node scripts/check-code-structure.mjs && node scripts/check-role-comments.mjs --self-test && node scripts/check-role-comments.mjs && eslint src workspace-cloud site --ext .ts,.tsx --max-warnings 0 && eslint scripts/benchmark-packaged-release.mjs scripts/benchmark --max-warnings 0 && node scripts/check-ui-primitives.mjs && node scripts/check-ui-palette.mjs && tsc -p tsconfig.node.json && tsc && vite build --config vite.config.ts",
    "benchmark:data-surfaces": "node --expose-gc --no-warnings scripts/benchmark-data-surfaces.mjs",
    "benchmark:packaged-release": "node --no-warnings scripts/benchmark-packaged-release.mjs",
    "benchmark:render-hot-paths": "node --no-warnings scripts/benchmark-render-hot-paths.mjs",
    "generate:skills": "node scripts/generate-skill-bundle.mjs",
    "check:skills": "node scripts/generate-skill-bundle.mjs --check",
    "check:agent-runtime": "node scripts/prepare-agent-runtime.mjs --check-config && node scripts/agent-runtime/build-acp-plugin.mjs --check-config",
    "check:agent-runtime:published": "node scripts/agent-runtime/verify-published-acp.mjs",
    "check:knowledge": "pnpm --dir workspace-cloud test:contracts",
    "check:issue-review": "node scripts/issue-review/local-issue-review.mjs --self-test",
    "check:workspace-logs": "node scripts/check-workspace-server-logs.mjs",
    "check:release-notes": "node scripts/release/generate-release-notes.mjs check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:code-structure": "node scripts/check-code-structure.mjs",
    "audit:code-structure": "node scripts/check-code-structure.mjs --audit",
    "check:role-comments": "node scripts/check-role-comments.mjs",
    "check:ui-primitives": "node scripts/check-ui-primitives.mjs",
    "check:ui-palette": "node scripts/check-ui-palette.mjs",
    "check:test-budget": "node scripts/check-critical-test-budget.mjs",
    "lint": "pnpm lint:hooks",
    "lint:hooks": "eslint src workspace-cloud site --ext .ts,.tsx --max-warnings 0",
    "lint:benchmark": "eslint scripts/benchmark-packaged-release.mjs scripts/benchmark --max-warnings 0",
    "issue:review": "node scripts/issue-review/local-issue-review.mjs --once",
    "issue:review:initialize": "node scripts/issue-review/local-issue-review.mjs --initialize",
    "issue:review:one": "node scripts/issue-review/local-issue-review.mjs --issue",
    "issue:review:backfill": "node scripts/issue-review/local-issue-review.mjs --backfill",
    "issue:review:install": "node scripts/issue-review/launch-agent.mjs install",
    "issue:review:status": "node scripts/issue-review/launch-agent.mjs status",
    "issue:review:uninstall": "node scripts/issue-review/launch-agent.mjs uninstall",
    "release:stable:draft": "bash scripts/release/create-stable-draft.sh",
    "release:notes:preview": "node scripts/release/generate-release-notes.mjs preview",
    "test": "node scripts/check-critical-test-budget.mjs && vitest run src/features/queryResults/DataGridVirtual.test.ts src/features/providers/tauriAdapter.test.ts src/features/queries/tauriAdapter.test.ts src/features/query/runSignal.test.ts src/features/skills/setupPolicy.test.ts src/features/agents/sessionStore.test.ts src/features/workbench/state.test.ts src/features/workspaces/authPolicy.test.ts",
    "test:smoke": "vitest run src/features/queryResults/DataGridVirtual.test.ts src/features/providers/tauriAdapter.test.ts src/features/queries/tauriAdapter.test.ts src/features/query/runSignal.test.ts src/features/skills/setupPolicy.test.ts src/features/agents/sessionStore.test.ts src/features/workbench/state.test.ts src/features/workspaces/authPolicy.test.ts",
    "test:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --package dopedb --lib && cargo test --package dopedb-protocol --test golden && cargo test --package dopedb-cli --test terminal_session_e2e && cargo test --package release-updater-verify",
    "test:ci": "bash scripts/test-all.sh",
    "workspace:migrate": "bash scripts/migrate-workspace-service.sh",
    "workspace:cloud:dev": "pnpm --dir workspace-cloud dev",
    "workspace:cloud:build": "pnpm --dir workspace-cloud build",
    "workspace:cloud:verify-deployment": "node scripts/check-workspace-deployment.mjs",
    "analytics:cloudflare:build": "pnpm --dir product-analytics-cloudflare build",
    "analytics:cloudflare:test": "pnpm --dir product-analytics-cloudflare test",
    "analytics:cloudflare:deploy": "pnpm --dir product-analytics-cloudflare deploy",
    "scheduler:cloudflare:build": "pnpm --dir workspace-scheduler-cloudflare build",
    "scheduler:cloudflare:test": "pnpm --dir workspace-scheduler-cloudflare test",
    "scheduler:cloudflare:deploy": "pnpm --dir workspace-scheduler-cloudflare deploy",
    "repo:owner-identity": "bash scripts/with-repository-owner-identity.sh",
    "gh:owner": "bash scripts/with-gh-owner.sh",
    "gh:restore": "bash scripts/with-gh-owner.sh --restore",
    "build:sidecars": "bash scripts/build-sidecars.sh",
    "sign:dev": "bash src-tauri/sign-dev.sh",
    "dev:app": "pnpm tauri dev",
    "preview": "vite preview --config vite.config.ts",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:cloud:deploy": "node scripts/deploy-site-cloudflare.mjs",
    "site:cloud:test-deploy": "node scripts/test-deploy-site-cloudflare.mjs",
    "site:cloud:verify-deployment": "node scripts/check-site-deployment.mjs",
    "site:preview": "pnpm --dir site start",
    "icons": "python3 scripts/generate-icons.py",
    "tauri": "bash scripts/tauri.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@floating-ui/react-dom": "^2.1.9",
    "@iconify-react/simple-icons": "1.0.26",
    "@sentry/react": "10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.12",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.6",
    "elkjs": "0.12.0",
    "jspdf": "4.2.1",
    "mermaid": "^12.0.0",
    "pretendard": "1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "sql-formatter": "15.8.2"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@babel/parser": "8.0.5",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
