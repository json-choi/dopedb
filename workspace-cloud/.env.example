DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
WORKSPACE_CREDENTIAL_KEY=replace-with-32-random-base64url-bytes
# Workspace metadata backup DEKs are wrapped by this symmetric Cloud KMS key.
# Vercel OIDC exchanges through this exact WIF provider and impersonates only
# the key-scoped Encrypter/Decrypter service account; never paste a JSON key.
WORKSPACE_KMS_KEY_NAME=projects/dopedb-security/locations/global/keyRings/dopedb-workspace/cryptoKeys/workspace-backup
WORKSPACE_KMS_WIF_AUDIENCE=//iam.googleapis.com/projects/123456789012/locations/global/workloadIdentityPools/vercel/providers/dopedb-workspace
WORKSPACE_KMS_SERVICE_ACCOUNT_EMAIL=dopedb-workspace-kms@dopedb-security.iam.gserviceaccount.com
# The dedicated Cloudflare scheduler sends this value to the credential and
# maintenance routes as `Authorization: Bearer ...`.
CRON_SECRET=replace-with-64-lowercase-hex-characters
# Event-driven background wake-ups. Keep disabled until the scheduler Worker,
# D1 migration, both Worker secrets, and the internal receipt smoke are ready.
WORKSPACE_BACKGROUND_SCHEDULER_ENABLED=0
WORKSPACE_BACKGROUND_SCHEDULER_URL=https://dopedb-workspace-scheduler.example.workers.dev/v1/kick
WORKSPACE_BACKGROUND_SCHEDULER_TOKEN=replace-with-64-lowercase-hex-characters
# Optional shared Project Knowledge. These values belong to one centrally
# managed, read-only GitHub App; workspace members never create a webhook.
GITHUB_KNOWLEDGE_APP_ID=123456
GITHUB_KNOWLEDGE_APP_SLUG=dopedb-knowledge
GITHUB_KNOWLEDGE_CLIENT_ID=replace-with-github-app-client-id
GITHUB_KNOWLEDGE_CLIENT_SECRET=replace-with-github-app-client-secret
GITHUB_KNOWLEDGE_APP_PRIVATE_KEY=base64-encoded-pem-or-pem-with-escaped-newlines
GITHUB_KNOWLEDGE_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
# Paid/experimental graph indexing stays fail-closed. GitHub source browsing
# remains available through exact-commit tree and file reads when this is 0.
KNOWLEDGE_GRAPH_BUILDS_ENABLED=0
# Optional managed database access. Both values must be set.
PLANETSCALE_CLIENT_ID=replace-with-planetscale-oauth-client-id
PLANETSCALE_CLIENT_SECRET=replace-with-planetscale-oauth-client-secret
# Optional HashiCorp Vault Database Secrets brokers. Only these exact HTTPS
# origins can be entered by a workspace owner; custom TLS ports such as 8200
# are allowed. Separate multiple pre-approved origins with commas.
VAULT_BROKER_ORIGINS=https://vault.example.com:8200
# GCP Cloud SQL uses Vercel OIDC/WIF and intentionally has no service-account key.
# VERCEL_OIDC_TOKEN is injected by Vercel at runtime. Never paste that short-lived
# token or a service-account JSON key into this file.
# Optional invitation delivery. Both must be set; otherwise admins copy the secure link.
RESEND_API_KEY=re_replace-me
WORKSPACE_INVITATION_FROM=DopeDB <workspace@example.com>
# Optional first-party product outcome sink. Keep the explicit switch at 0 until
# the relay smoke, privacy, retention, and official-client activation review pass.
# The URL is restricted to the dedicated Cloudflare analytics Worker.
PRODUCT_ANALYTICS_RELAY_ENABLED=0
PRODUCT_ANALYTICS_CLOUDFLARE_URL=https://dopedb-product-analytics.example.workers.dev/v1/events
PRODUCT_ANALYTICS_CLOUDFLARE_TOKEN=replace-with-64-lowercase-hex-characters
