{
  "name": "dopedb-product-analytics-cloudflare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dopedb-product-analytics --local",
    "db:migrate:remote": "wrangler d1 migrations apply dopedb-product-analytics --remote"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
